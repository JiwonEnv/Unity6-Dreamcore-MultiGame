<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="UI_OutGame.uss" />
    <ui:VisualElement name="create-room-screen" class="screen screen--solid">
        <ui:VisualElement class="panel">
            <ui:Label text="방 만들기" class="heading" />
            <ui:DropdownField name="max-players" label="최대 인원" class="field" />
            <ui:DropdownField name="visibility" label="공개 범위" class="field" />
            <ui:Label text="공개 범위는 접속 방식(참가 코드 · Steam 초대)이 정해지면 적용됩니다. 지금은 주소를 아는 사람이 참가합니다." class="hint" />
            <ui:Label name="my-address" text="내 주소" class="body" />
            <ui:VisualElement class="row">
                <ui:Button name="back" text="뒤로" class="button--small" />
                <ui:Button name="create" text="만들기" class="button--small" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
