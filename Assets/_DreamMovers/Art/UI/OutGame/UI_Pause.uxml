<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="UI_OutGame.uss" />
    <ui:VisualElement name="pause-screen" class="screen screen--dim">
        <ui:VisualElement class="panel">
            <ui:Label text="일시정지" class="heading" />
            <ui:Label text="함께 하는 게임이라 시간은 멈추지 않습니다." class="hint" />
            <ui:Button name="resume" text="계속하기" class="button" />
            <ui:Button name="settings" text="설정" class="button" />
            <ui:Button name="show-keys" text="조작 키 보기" class="button" />
            <ui:Label name="keys" class="body" />
            <ui:Label text="방에 있는 사람" class="body" style="-unity-font-style: bold; margin-top: 12px;" />
            <ui:Label name="players" class="body" />
            <ui:Button name="leave" text="방 나가기" class="button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
